# ERP / BMS (http://159.223.235.20:4001) — confirmed invoices
ERP_BASE_URL=http://159.223.235.20:4001
ERP_API_KEY=b1f7338daa8a9ed5d42daa1d87345fc000f6302959f8dd6fb322e3eecc27d9f5
# Primary: GET /api/v1/invoices/confirmed?shape=flat  (X-API-Key from above)
# Required to show kassa symbol in ERP after accept («Получено кассой»):
# use an ERP account with cashier/bank/admin rights (phone or username + password)
ERP_LOGIN_PHONE=
ERP_LOGIN_PASSWORD=
# Or paste a session token from ERP UI instead:
# ERP_BEARER_TOKEN=
# Fail accept if ERP kassa mark cannot be written (default true)
ERP_REQUIRE_PUSH=true
ERP_SYNC_INVOICES=true
ERP_INVOICE_LIMIT=2000
ERP_INVOICE_PAGE_SIZE=100
# Optional business-trips (off by default)
ERP_SYNC_TRIPS=false
# Auto-sync every 5 minutes (0 = off)
ERP_SYNC_INTERVAL_MS=300000
